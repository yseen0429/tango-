      let startIndex = 0;\
      const headerKeywords = ['\uc0\u34920 \u38754 ', 'front', '\u21336 \u35486 ', 'word', 'term', 'question', '\u35023 \u38754 ', 'meaning', 'back'];\
      const firstRowLower = rows[0].map(c => c.toLowerCase());\
      if (firstRowLower.some(cell => headerKeywords.some(k => cell.includes(k)))) \{\
        startIndex = 1;\
      \}\
\
      let addedCount = 0;\
